<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="15.0" prefWidth="800.0" prefHeight="600.0"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.frontend.Client.StudentController"
      style="-fx-background-color: #121214;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Student Management" textFill="WHITE" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Logout" fx:id="logoutButton" onAction="#handleLogout" 
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <Separator />

    <HBox spacing="10">
        <VBox spacing="10" prefWidth="250">
            <Label text="Add / Edit Student" textFill="WHITE" style="-fx-font-weight: bold;"/>
            <TextField fx:id="firstNameField" promptText="First Name" />
            <TextField fx:id="lastNameField" promptText="Last Name" />
            <TextField fx:id="emailField" promptText="Email" />
            <HBox spacing="10">
                <Button text="Save" onAction="#handleSave" prefWidth="80"
                        style="-fx-background-color: #10b981; -fx-text-fill: white;"/>
                <Button text="Clear" onAction="#handleClear" prefWidth="80"
                        style="-fx-background-color: #6b7280; -fx-text-fill: white;"/>
            </HBox>
        </VBox>

        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50" />
                    <TableColumn fx:id="firstNameColumn" text="First Name" prefWidth="150" />
                    <TableColumn fx:id="lastNameColumn" text="Last Name" prefWidth="150" />
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="200" />
                </columns>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Delete Selected" onAction="#handleDelete"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white;"/>
                <Button text="Refresh" onAction="#loadStudents"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>

