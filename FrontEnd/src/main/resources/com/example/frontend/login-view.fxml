<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="350.0" prefHeight="400.0"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.frontend.Client.LoginController"
      style="-fx-background-color: #1e1e24;">

  <padding>
    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
  </padding>

  <Label text="System Login" textFill="WHITE" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

  <VBox spacing="5.0" alignment="CENTER_LEFT">
    <Label text="Username" textFill="#b0b0b5" />
    <TextField fx:id="usernameField" promptText="Enter your username"
               style="-fx-background-color: #2a2a35; -fx-text-fill: white;"/>
  </VBox>

  <VBox spacing="5.0" alignment="CENTER_LEFT">
    <Label text="Password" textFill="#b0b0b5" />
    <PasswordField fx:id="passwordField" promptText="Enter your password"
                   style="-fx-background-color: #2a2a35; -fx-text-fill: white;"/>
  </VBox>

  <Button text="Sign In" onAction="#handleLogin" prefWidth="200.0"
          style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

  <Label fx:id="errorLabel" textFill="#ef4444" wrapText="true"/>
</VBox>